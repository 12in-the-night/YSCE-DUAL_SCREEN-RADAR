REM update piko1
REM engin Hispano-Suiza, Avia HS 12Ydrs 632KW/860hp
IDENTIFY "AVIA B534 SNP"
CATEGORY WW2FIGHTER
AFTBURNR FALSE                 #HAVE AFTERBURNER?
PROPELLR 860HP                 #PROPELLER ENGINE
WEIGHCLN  1.46t                #WEIGHT CLEAN
WEIGFUEL  0.23t                #WEIGHT OF FUEL
WEIGLOAD  0.08t                #WEIGHT OF PAYLOAD
FUELMILI  0.07kg               #FUEL CONSUMPTION AT MILITARY POWER

COCKPITP  0.0m  0.6m  -1.55m #COCKPIT POSITION
INSTPANL user/volume/avia-snp/avia-snp.ist
LEFTGEAR -0.91m -2.17m  0.29m  #LEFT LANDING GEAR POSITION
RIGHGEAR  0.91m -2.17m  0.29m  #RIGHT LANDING GEAR POSITION
WHELGEAR  0.0m  -0.69m -4.78m  #WHEEL POSITION
MACHNGUN  0.42m  0.02m  0m        #MACHINE GUN POSITION
MACHNGN2 -0.42m  0.02m  0m        #MACHINE2 GUN POSITION
MACHNGN3 -0.40m -0.22m  0m
MACHNGN4  0.40m -0.22m  0m

GUNINTVL  0.1
SMOKEGEN  0.0m  -0.30m -2.00m  #SMOKE GENERATOR POSITION
VAPORPO0  3.99m -0.53m -1.01m       #VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1  3.99m -0.53m -1.01m       #VAPOR POSITION (Wings Spread)
HTRADIUS  6m                   #OUTSIDE SPHERE RADIUS
GUNSIGHT FALSE

TRIGGER1 GUN
TRIGGER2 SMK
TRIGGER3 
TRIGGER4 

STRENGTH 6

CRITAOAP  14deg               #CRITICAL AOA POSITIVE
CRITAOAM -10deg               #CRITICAL AOA NEGATIVE

CRITSPED 430km/h              #CRITICAL SPEED
MAXSPEED 405km/h              #MAXIMUM SPEED

HASSPOIL FALSE                #HAS SPOILER?
RETRGEAR FALSE                #HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE                #HAS VARIABLE GEOMETRY WING?

VGWSPED1 0kt
VGWSPED2 0.01kt

CLVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.0                  #EFFECT OF FLAP FOR Cl
CDBYFLAP 0.0                  #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.0                  #EFFECT OF GEAR FOR Cd
CDSPOILR 0.0                  #EFFECT OF SPOILER FOR Cd

WINGAREA 23.56m^2             #WING AREA

MXIPTAOA 16.0deg              #MAX INPUT AOA
MXIPTSSA 5.0deg               #MAX INPUT SSA
MXIPTROL 65.0deg              #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 35kt                 #MINIMUM MANEUVABLE SPEED
MANESPD2 60kt                 #FULLY MANEUVABLE SPEED
CPITMANE 7.0                  #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  #PITCH STABILITY CONSTANT
CYAWMANE 5.0                  #YAW MANEUVABILITY CONSTANT
CYAWSTAB 2.0                  #YAW STABILITY CONSTANT
CROLLMAN 3.0                  #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 #CONTROL LANDINGGEAR
CTLBRAKE FALSE                #CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE                #CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m            #POSITION
ATTITUDE 45deg 0deg 0deg      #ATTITUDE
INITFUEL 75%                  #INITIAL FUEL
INITLOAD 0.0t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED
WEAPONCH GUN
GUNPOWER 1

INITIGUN 1500                  #INITIAL GUN
INITIAAM 0                    #INITIAL AAM
INITIAGM 0                    #INITIAL AGM
INITBOMB 0                    #INITIAL BOMB

RADARCRS 0.001

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 355km/h              #CRUISING SPEED
REFACRUS 8500ft               #CRUISING ALTITUDE
REFTCRUS 0.8                  #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 70kt                 #LANDING SPEED
REFAOALD 8deg                 #LANDING AOA
REFLNRWY 300m                 #RUNWAY REQUIRED TO STOP
REFTHRLD 0.45                  #LANDING THROTTLE SETTING

AUTOCALC