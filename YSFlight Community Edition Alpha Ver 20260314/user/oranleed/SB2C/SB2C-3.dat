REM HELLDIVER
IDENTIFY "SB2C-3_HELLDIVER"
CATEGORY WW2ATTACKER
AFTBURNR FALSE                #HAVE AFTERBURNER?
PROPELLR 1900HP              #PROPELLER ENGINE
WEIGHCLN 4.76t                #WEIGHT CLEAN
WEIGFUEL 0.812t                #WEIGHT OF FUEL
WEIGLOAD 1.965t                #WEIGHT OF PAYLOAD
FUELMILI 0.1kg               #FUEL CONSUMPTION AT MILITARY POWER
PROPVMIN 120kt				#Minimum speed that T=P/V becomes valid

NREALPRP 1                            # Number of (realistic) propeller engines
REALPROP 0 NBLADE         4           # 1 argument.  Number of blades.
REALPROP 0 AREAPERBLADE   0.32m^2      # 1 argument.  Blade area.  About 1.5m length times 0.2m width, roughly.
REALPROP 0 CL 0deg 0.1 15deg 0.23      # 4 argument.  cl1 AOA1 cl2 AOA2   (Approximated by a linear function)
REALPROP 0 CD -5deg 0.01 20deg 0.04   # 4 argument.  minCd AOAminCd cd1 AOA1 (Approximated by a quadratic function)
REALPROP 0 PITCHCHGRATE  10deg        # 1 argument.  Maximum angular velocity that the blade can change pitch.  (per sec)
REALPROP 0 MINPITCH       21deg       # 1 argument.  Minimum propeller pitch.
REALPROP 0 MAXPITCH       51deg       # 1 argument.  Maximum propeller pitch.
REALPROP 0 KGOVERNER      0.005        # 1 argument.  Governer const.  Defines the reaction speed of the propeller governer.
REALPROP 0 GRAVITYCENTER  0.6m        # 1 argument.  Distance from the rotation axis  roughly 0.25m(spinner)+0.75m(prop)
REALPROP 0 LIFTCENTER     1.1m        # 1 argument.  Distance from the rotation axis
REALPROP 0 WEIGHTPERBLADE 50kg        # 1 argument.  The weight of one blade.  Probably something like this.
REALPROP 0 CLOCKWISE      0           # 1 argument.  This engine rotates clockwise. Argument is the zero-based blade index.
REALPROP 0 MAXPOWER       1900HP      # 1 argument.  Maximum horse power or J/s
REALPROP 0 IDLEPOWER      70HP        # 1 argument.  Idling horse power or J/s
REALPROP 0 RPMCTLRANGE    1800 2800   # 1 argument.  Range of RPM for prop-lever position.

TIREFRIC 0.04                #TIRE FRICTION COEFFICIENT

COCKPITP 0.00m  1.08m 0.28m    #COCKPIT POSITION
EXCAMERA "GUNNER" 0m 0.9m -2.25m 180deg 0deg 0deg  CABIN
ISPNLPOS 0.0m 1.07m 0.85m
ISPNLSCL 0.4
INSTPANL user/oranleed/SB2C/SB2C.ist
LEFTGEAR  -2.33m -2.05m  0.8m   #LEFT LANDING GEAR POSITION
RIGHGEAR  2.33m -2.05m  0.8m    #RIGHT LANDING GEAR POSITION
WHELGEAR  0.00m -0.58m -5.45m    #WHEEL POSITION
ARRESTER  0.00m -0.3m -7.15m    #Arresting hook position
MACHNGUN  2.7m  -0.16m  1m   #MACHINE GUN POSITION
MACHNGN2  -2.7m  -0.16m 1m  #MACHINE GUN POSITION
SMOKEGEN  0.0m   0.00m -6.00m    #SMOKE GENERATOR POSITION
VAPORPO0 -7.585m   0.393m  0.638m   #VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 -7.585m   0.393m  0.638m   #VAPOR POSITION (Wings Spread)
HTRADIUS 7.5m                   #OUTSIDE SPHERE RADIUS
GUNPOWER 3
GUNINTVL 0.08
GUNSIGHT FALSE

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

STRENGTH 16

CRITAOAP 20deg               #CRITICAL AOA POSITIVE
CRITAOAM -10deg               #CRITICAL AOA NEGATIVE

CRITSPED 300kt            #CRITICAL SPEED
MAXSPEED 255kt            #MAXIMUM SPEED

HASSPOIL TRUE                 #HAS SPOILER?
RETRGEAR TRUE                 #HAS RETRACTABLE LANDING GEAR?
VARGEOMW TRUE               #HAS VARIABLE GEOMETRY WING?

VGWSPED1 0kt
VGWSPED2 30kt


CLVARGEO 0.0                 #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 1                  #EFFECT OF FLAP FOR Cl
CDBYFLAP 2                  #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5                 #EFFECT OF GEAR FOR Cd
CDSPOILR 4                  #EFFECT OF SPOILER FOR Cd

WINGAREA 39.20m^2                #WING AREA

MXIPTAOA 18.0deg              #MAX INPUT AOA
MXIPTSSA 8.0deg               #MAX INPUT SSA
MXIPTROL 80.0deg             #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 70kt                 #MINIMUM MANEUVABLE SPEED
MANESPD2 135kt                 #FULLY MANEUVABLE SPEED
CPITMANE 6.0                  #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  #PITCH STABILITY CONSTANT
CYAWMANE 2.0                  #YAW MANEUVABILITY CONSTANT
CYAWSTAB 1.5                  #YAW STABILITY CONSTANT
CROLLMAN 0.8                  #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 #CONTROL LANDINGGEAR
CTLBRAKE FALSE                #CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE                #CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW TRUE               #CONTROL AUTO VARIABLE GEOMETRY WING

STALHORN FALSE

POSITION 0m 3ft 0m           #POSITION
ATTITUDE 45deg 15deg 0deg      #ATTITUDE
INITFUEL 75%                 #INITIAL FUEL
INITLOAD 0.8t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED
WEAPONCH GUN


HRDPOINT 0.225m -0.5m 0m B500 B250
HRDPOINT -0.225m -0.5m 0m B500 B250
HRDPOINT -3.5m -0.465m 0m B250 FUEL&220 B500
HRDPOINT 3.5m -0.465m 0m B250 FUEL&220 B500
LMTBYHDP TRUE                 #Limit Max Num Weapon by Hardpoint
BOMINBAY TRUE				#Bomb in Bay

INITIGUN 500                  #INITIAL GUN
INITIAAM 0                    #INITIAL AAM
INITIAGM 0                    #INITIAL AGM
LOADWEPN B500 2

NMTURRET 4
TURRETPO 0 0m 0.8m -2.25m 180deg 10deg 0deg      # Number x y z h p b
TURRETPT 0 -10deg 60deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -60deg 60deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 2000                              # Ammo
TURRETIV 0 0.2sec                            # Number ShootingInterval
TURRETNH 0 66
TURRETNP 0 39                           # DNM Node Name
TURRETAR 0                                   # Anti Air Capable
TURRETCT 0 GUNNER                            # Controlled by PILOT or GUNNER
TURRETRG 0 500m

TURRETPO 1 0m 0m 0m 0deg -60deg 0deg      # Number x y z h p b
TURRETPT 1 0deg 0deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 1 0deg 0deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 1 0                             # Ammo
TURRETIV 1 0.3sec                            # Number ShootingInterval
TURRETAR 1                                   # Anti Air Capable
TURRETCT 1 PILOT                           # Controlled by PILOT or GUNNER
TURRETRG 1 500m

TURRETPO 2 0m 0m 0m 0deg 0deg 0deg      # Number x y z h p b
TURRETPT 2 0deg 0deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 2 -90deg 0deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 2 0                             # Ammo
TURRETIV 2 0.3sec                            # Number ShootingInterval
TURRETNH 2 145
TURRETAR 2                                   # Anti Air Capable
TURRETCT 2 PILOT                           # Controlled by PILOT or GUNNER
TURRETRG 2 500m

TURRETPO 3 0m 0m 0m 0deg 0deg 0deg      # Number x y z h p b
TURRETPT 3 0deg 0deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 3 0deg 90deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 3 0                             # Ammo
TURRETIV 3 0.3sec                            # Number ShootingInterval
TURRETNH 3 144
TURRETAR 3                                   # Anti Air Capable
TURRETCT 3 PILOT                           # Controlled by PILOT or GUNNER
TURRETRG 3 500m

WPNSHAPE B500 STATIC user/oranleed/SB2C/ANM64.srf
WPNSHAPE B500 FLYING user/oranleed/SB2C/ANM64.srf
WPNSHAPE B250 STATIC user/oranleed/SB2C/ANM57.srf
WPNSHAPE B250 FLYING user/oranleed/SB2C/ANM57.srf
WPNSHAPE FUEL STATIC user/oranleed/SB2C/58galDT.srf
WPNSHAPE FUEL FLYING user/oranleed/SB2C/58galDT.srf

RADARCRS 1

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 255kt             #CRUISING SPEED(*1.2
REFACRUS 5180m              #CRUISING ALTITUDE
REFTCRUS 0.76               #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 80kt                 #LANDING SPEED
REFAOALD 7.5deg                #LANDING AOA
REFLNRWY 400m                #RUNWAY REQUIRED TO STOP
REFTHRLD 0.5                #LANDING THROTTLE SETTING
AUTOCALC