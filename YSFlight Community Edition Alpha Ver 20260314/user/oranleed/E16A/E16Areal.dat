REM ZUIUN
IDENTIFY "E16A1(RealProp)"
CATEGORY WW2ATTACKER
AFTBURNR FALSE                #HAVE AFTERBURNER?
PROPELLR 1300HP              #PROPELLER ENGINE
WEIGHCLN  2.8t                #WEIGHT CLEAN
WEIGFUEL  0.94t                #WEIGHT OF FUEL
WEIGLOAD  0.26t                #WEIGHT OF PAYLOAD
FUELMILI 0.1kg               #FUEL CONSUMPTION AT MILITARY POWER
PROPVMIN 120kt				#Minimum speed that T=P/V becomes valid


NREALPRP 1                            # Number of (realistic) propeller engines
REALPROP 0 NBLADE         3           # 1 argument.  Number of blades.
REALPROP 0 AREAPERBLADE   0.32m^2      # 1 argument.  Blade area.  About 1.5m length times 0.2m width, roughly.
REALPROP 0 CL 0deg 0.04 15deg 0.2      # 4 argument.  cl1 AOA1 cl2 AOA2   (Approximated by a linear function)
REALPROP 0 CD -5deg 0.001 20deg 0.05   # 4 argument.  minCd AOAminCd cd1 AOA1 (Approximated by a quadratic function)
REALPROP 0 PITCHCHGRATE  10deg        # 1 argument.  Maximum angular velocity that the blade can change pitch.  (per sec)
REALPROP 0 MINPITCH       22deg       # 1 argument.  Minimum propeller pitch.
REALPROP 0 MAXPITCH       45deg       # 1 argument.  Maximum propeller pitch.
REALPROP 0 KGOVERNER      0.005        # 1 argument.  Governer const.  Defines the reaction speed of the propeller governer.
REALPROP 0 GRAVITYCENTER  0.6m        # 1 argument.  Distance from the rotation axis  roughly 0.25m(spinner)+0.75m(prop)
REALPROP 0 LIFTCENTER     1.1m        # 1 argument.  Distance from the rotation axis
REALPROP 0 WEIGHTPERBLADE 50kg        # 1 argument.  The weight of one blade.  Probably something like this.
REALPROP 0 CLOCKWISE      0           # 1 argument.  This engine rotates clockwise. Argument is the zero-based blade index.
REALPROP 0 MAXPOWER       1300HP      # 1 argument.  Maximum horse power or J/s
REALPROP 0 IDLEPOWER      30HP        # 1 argument.  Idling horse power or J/s
REALPROP 0 RPMCTLRANGE    1000 2600   # 1 argument.  Range of RPM for prop-lever position.


COCKPITP  0.00m  0.8m -0.25m    #COCKPIT POSITION
EXCAMERA "GUNNER" 0m 0.75m -1.8m 180deg 0deg 0deg CABIN
ISPNLPOS 0.0m 0.8m 0.325m
ISPNLSCL 0.4
INSTPANL user/oranleed/E16A/E16Areal.ist
LEFTGEAR  -1.6m -1.8m  -3.5m   #LEFT LANDING GEAR POSITION
RIGHGEAR  1.6m -1.8m  -3.5m    #RIGHT LANDING GEAR POSITION
WHELGEAR  0.00m -2m 1.5m    #WHEEL POSITION
ARRESTER  0.00m -0.51m -5.66m    #Arresting hook position
MACHNGUN  2.3m  -0.295m  1.3m   #MACHINE GUN POSITION
MACHNGN2  -2.3m  -0.295m 1.3m  #MACHINE GUN POSITION
SMOKEGEN  0.0m   0.00m -6.00m    #SMOKE GENERATOR POSITION
VAPORPO0 -6.4m   -0.065m  0.5m   #VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 -6.4m   -0.065m  0.5m   #VAPOR POSITION (Wings Spread)
HTRADIUS  8.0m                   #OUTSIDE SPHERE RADIUS
GUNPOWER 3
GUNINTVL 0.12
GUNSIGHT FALSE

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

STRENGTH 8

CRITAOAP 16deg               #CRITICAL AOA POSITIVE
CRITAOAM -10deg               #CRITICAL AOA NEGATIVE

CRITSPED 350kt            #CRITICAL SPEED
MAXSPEED 242kt             #MAXIMUM SPEED

HASSPOIL TRUE                 #HAS SPOILER?
RETRGEAR TRUE                 #HAS RETRACTABLE LANDING GEAR?
VARGEOMW TRUE               #HAS VARIABLE GEOMETRY WING?

VGWSPED1 120kt
VGWSPED2 180kt


CLVARGEO 0.2                 #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.3                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.4                  #EFFECT OF FLAP FOR Cl
CDBYFLAP 0.6                  #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.03                 #EFFECT OF GEAR FOR Cd
CDSPOILR 0.6                  #EFFECT OF SPOILER FOR Cd

WINGAREA 28.0m^2                #WING AREA

MXIPTAOA 17.0deg              #MAX INPUT AOA
MXIPTSSA 8.0deg               #MAX INPUT SSA
MXIPTROL 50.0deg             #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 40kt                 #MINIMUM MANEUVABLE SPEED
MANESPD2 90kt                 #FULLY MANEUVABLE SPEED
CPITMANE 6.0                  #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  #PITCH STABILITY CONSTANT
CYAWMANE 5.0                  #YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0                  #YAW STABILITY CONSTANT
CROLLMAN 3.0                  #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 #CONTROL LANDINGGEAR
CTLBRAKE FALSE                #CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE                #CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW TRUE               #CONTROL AUTO VARIABLE GEOMETRY WING



POSITION 0m 3ft 0m           #POSITION
ATTITUDE 45deg 15deg 0deg      #ATTITUDE
INITFUEL 75%                 #INITIAL FUEL
INITLOAD 0.26t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED
WEAPONCH GUN


HRDPOINT 0.00m -0.85m -0.25m B500
HRDPOINT -3m -0.55m 0m B250 
HRDPOINT 3m -0.55m 0m B250 
HRDPOINT -3.65m -0.57m 0m RKT*1
HRDPOINT 3.65m -0.57m 0m RKT*1
HRDPOINT -3.9m -0.57m 0m RKT*1
HRDPOINT 3.9m -0.57m 0m RKT*1
LMTBYHDP TRUE                 #Limit Max Num Weapon by Hardpoint

INITIGUN 500                  #INITIAL GUN
INITIAAM 0                    #INITIAL AAM
INITIAGM 0                    #INITIAL AGM
LOADWEPN B500 1

NMTURRET 1
TURRETPO 0 0m 0.55m -2m 180deg 5deg 0deg      # Number x y z h p b
TURRETPT 0 -5deg 30deg 0deg                  # Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -30deg 30deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 300                              # Ammo
TURRETIV 0 0.3sec                            # Number ShootingInterval
TURRETNM 0 107                           # DNM Node Name
TURRETAR 0                                   # Anti Air Capable
TURRETCT 0 GUNNER                            # Controlled by PILOT or GUNNER
TURRETRG 0 500m

RADARCRS 1

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 242kt              #CRUISING SPEED(*1.2
REFACRUS 5580m              #CRUISING ALTITUDE
REFTCRUS 1.0               #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 60kt                 #LANDING SPEED
REFAOALD 6deg                #LANDING AOA
REFLNRWY 200m                #RUNWAY REQUIRED TO STOP
REFTHRLD 0.5                 #LANDING THROTTLE SETTING

WPNSHAPE B250 STATIC user/oranleed/E16A/60kgt97_fly.srf
WPNSHAPE B250 FLYING user/oranleed/E16A/60kgt97_fly.srf
WPNSHAPE B500 STATIC user/oranleed/E16A/250kgt98_fly.srf
WPNSHAPE B500 FLYING user/oranleed/E16A/250kgt98_fly.srf
WPNSHAPE RKT STATIC user/oranleed/E16A/10kgt3rkt_stat.srf
WPNSHAPE RKT FLYING user/oranleed/E16A/10kgt3rkt_fly.srf
AUTOCALC
