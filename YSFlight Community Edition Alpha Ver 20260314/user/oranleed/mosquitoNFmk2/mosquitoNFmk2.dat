IDENTIFY "Mosquito_NF_MK.II"
CATEGORY WW2FIGHTER
SUBSTNAM "LANCASTER"
AFTBURNR FALSE                		#HAVE AFTERBURNER?
PROPELLR 2960HP               		#PROPELLER ENGINE
WEIGHCLN 6218kg                		#WEIGHT CLEAN
WEIGFUEL 1623kg                		#WEIGHT OF FUEL
WEIGLOAD 708kg                		#WEIGHT OF PAYLOAD
FUELMILI 0.222kg               		#FUEL CONSUMPTION AT MILITARY POWER
PROPEFCY 0.75			#Propeller efficiency
PROPVMIN 150kt			#Minimum speed that T=P/V becomes valid

#Enpty weight : 6058kg , MAX takeoff weight : 8549kg
#Fuel consumption rate : 0.075kg/1000HP*min

COCKPITP -0.07m 0.44m 2.31m  	#COCKPIT POSITION
COCKPITA 0deg 0deg 0deg    		#COCKPIT NEUTRAL VIEW DIRECTION
SCRNCNTR 0.00 0.00		#Position of viewpoint
EXCAMERA "CoPilot(RADAR)" 0.294m 0.46m 1.93m 0deg -21.5deg 0deg INSIDE
LEFTGEAR -2.580m -2.480m  1.787m  	#LEFT LANDING GEAR POSITION
RIGHGEAR  2.580m -2.480m  1.787m  	#RIGHT LANDING GEAR POSITION
WHELGEAR  0m -0.734m -6.342m  	#WHEEL POSITION
ARRESTER  0m 0.12m -7.90m  		#ARRESTING FOOK
SMOKEGEN  -2.47m -0.29m 3.60m  	#SMOKE GENERATOR POSITION
VAPORPO0  8.25m  0.20m  1.34m  	#VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1  8.25m  0.20m  1.34m  	#VAPOR POSITION (Wings Spread)
HTRADIUS  9.2m                 		#OUTSIDE SPHERE RADIUS

STRENGTH 10

INSTPANL User/oranleed/mosquitoNFmk2/mosquitoNFmk2.ist
ISPNLPOS 0.0m 0.0m  2.769m       	#INSIDE PANEL POTITION
ISPNLATT 0deg 0deg 0deg     		#INSIDE PANEL ATTITUDE
ISPNLSCL 1.00                 		#INSIDE PANEL SCALE

CRITAOAP  18deg               		#CRITICAL AOA POSITIVE
CRITAOAM -15deg               		#CRITICAL AOA NEGATIVE

CRITSPED 270kt              		#CRITICAL SPEED
MAXSPEED 362kt              		#MAXIMUM SPEED

HASSPOIL FALSE                 		#HAS SPOILER?
RETRGEAR TRUE                 		#HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE                	#HAS VARIABLE GEOMETRY WING?
TRSTVCTR TRUE                 		#HAS THRUST VECTORING CAPABILITY?

TRSTDIR0 0.0m 0.0m 1.0m       		#Thrust vector 0
TRSTDIR1 0.0m 0.0m 1.0m       		#Thrust vector 1
PSTMPTCH 1.5deg                 		#Post-Stall Maneuver VPitch
PSTMYAW_ 0deg                 		#Post-Stall Maneuver VYaw
PSTMROLL 0deg                 		#Post-Stall Maneuver VRoll

CLVARGEO 0.0                  		#EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  		#EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.2                  		#EFFECT OF FLAP FOR Cl
CDBYFLAP 0.4                  		#EFFECT OF FLAP FOR Cd
CDBYGEAR 0.7                  		#EFFECT OF GEAR FOR Cd
CDSPOILR 0.0                  		#EFFECT OF SPOILER FOR Cd

WINGAREA 42.18m^2                	#WING AREA

MXIPTAOA 16.0deg              		#MAX INPUT AOA
MXIPTSSA 6.0deg               		#MAX INPUT SSA
MXIPTROL 55.0deg             		#MAX INPUT ROLL

MANESPD1 50kt                 		#MINIMUM MANEUVABLE SPEED
MANESPD2 100kt                 		#FULLY MANEUVABLE SPEED
CPITMANE 6.6                  		#PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  		#PITCH STABILITY CONSTANT
CYAWMANE 4.2                  		#YAW MANEUVABILITY CONSTANT
CYAWSTAB 2.0                  		#YAW STABILITY CONSTANT
CROLLMAN 3.0                  		#ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 		#CONTROL LANDINGGEAR
CTLBRAKE FALSE                		#CONTROL BRAKE
CTLSPOIL 0.0                  		#CONTROL SPOILER
CTLABRNR FALSE                		#CONTROL AFTERBURNER
CTLTHROT 0.0                  		#CONTROL THRUST
CTLIFLAP 0.0                  		#CONTROL FLAP
CTLINVGW 0.0                  		#CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                		#CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m           		#POSITION
ATTITUDE 45deg 0deg 0deg      	#ATTITUDE
INITFUEL 75%                 		#INITIAL FUEL
INITLOAD 0.0t                 		#INITIAL PAYLOAD
INITSPED 0.0MACH              		#INITIAL SPEED

INITIGUN 0                  		#INITIAL GUN
GUNSIGHT FALSE			#GUNSIGHT

HRDPOINT 0.0m -0.7m 1.0m B250*2 B500*1 $INTERNAL
HRDPOINT 0.0m -0.7m 1.0m B250*2 B500*1 $INTERNAL

WPNSHAPE B250 FLYING "User/tf58/weapons/gp250/bomb250.srf"
WPNSHAPE B500 FLYING "User/tf58/weapons/500lb MC bomb/bomb.srf"

LMTBYHDP TRUE                 		#Limit Max Num Weapon by Hardpoint
BOMINBAY FALSE			#Bomb In Bay

RADARCRS 1.0                 		#RADAR CROSS SECTION (BombDoor Close)
BMBAYRCS 1.0                 		#RADAR CROSS SECTION (BombDoor Open)

GEARHORN FALSE                		#LANDING-GEAR WARNING HORN
STALHORN FALSE                 	#STALL WARNING HORN

#1kt=1.852km/h

REFVCRUS 318kt              		#CRUISING SPEED
REFACRUS 21400ft              		#CRUISING ALTITUDE
REFTCRUS 1.0                  		#CRUISING THROTTLE SETTING

REFVLAND 80kt                 		#LANDING SPEED
REFAOALD 10deg                		#LANDING AOA
REFLNRWY 1200m                		#RUNWAY REQUIRED TO STOP
REFTHRLD 0.50                  		#LANDING THROTTLE SETTING

NMTURRET 19

#sight
TURRETPO 0 0m 0m 0m 0deg 0deg 0deg
TURRETPT 0 0deg 0deg 0deg
TURRETHD 0 0deg 0deg 0deg
TURRETAM 0 0
TURRETCT 0 PILOT

#7.7mm 500r/m 500rounds cross=400m
TURRETPO 1 0.250m -0.382m 4.435m 0.05deg 0.16deg 0deg
TURRETPT 1 0deg 0deg 0deg
TURRETHD 1 0deg 0deg 0deg
TURRETAM 1 250
TURRETIV 1 0.24sec
TURRETCT 1 PILOT
TURRETRG 1 400m
