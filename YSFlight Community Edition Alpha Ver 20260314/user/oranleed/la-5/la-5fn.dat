IDENTIFY "LA-5FN"
CATEGORY WW2FIGHTER
SUBSTNAM "Yak-3"
AFTBURNR FALSE
PROPELLR 1850HP
WEIGHCLN 2675kg
WEIGFUEL 419kg
WEIGLOAD 308kg
FUELMILI  0.139kg
PROPEFCY 0.75			#Propeller efficiency
PROPVMIN 70kt			#Minimum speed that T=P/V becomes valid

#emptyw:2605kg , loadedw:3265kg , maxtow:3402kg , range:765km , fuel:123galons
#gasoline:0.75kg/L , Fuel consumption rate:0.075kg/1000HP*min
#1kt=1.852km/h , 1ft=0.3048m , 1eng.gal=4.546L

LEFTGEAR -1.335m -1.788m 0.811m
RIGHGEAR 1.335m -1.788m 0.811m
WHELGEAR 0m -0.592m -4.36m
ARRESTER 0m -0.592m -4.36m
VAPORPO0 4.916m -0.161m 0.184m	#VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 4.916m -0.161m 0.184m	#VAPOR POSITION (Wings Spread)
HTRADIUS  6.5m

COCKPITP  0m 0.7056m -0.6985m
COCKPITA 0deg 0deg 0deg		#COCKPIT NEUTRAL VIEW DIRECTION
SCRNCNTR 0.00 -0.19		#CENTER OF SCREEN

EXCAMERA "ist" 0m 0.7056m -0.6985m 0deg 0deg 0deg INSIDE

INSTPANL user/oranleed/la-5/la-5fn.ist
ISPNLPOS 0m 0.435m -0.117m		#IST POTITION
ISPNLATT 0deg 0deg 0deg     		#IST ATTITUDE
ISPNLSCL 1.0                 		#IST SCALE

STRENGTH 8

CRITAOAP  15deg
CRITAOAM -10deg

CRITSPED 400kt
MAXSPEED 350kt

HASSPOIL FALSE
RETRGEAR TRUE
VARGEOMW TRUE

VGWSPED1 0kt			#VGW SPEED MIN
VGWSPED2 600kt			#VGW SPEED MAX

CLVARGEO 0.0			#EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0			#EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.2			#EFFECT OF FLAP FOR Cl
CDBYFLAP 0.4			#EFFECT OF FLAP FOR Cd
CDBYGEAR 0.4			#EFFECT OF GEAR FOR Cd
CDSPOILR 0.0			#EFFECT OF SPOILER FOR Cd

WINGAREA 17.5m^2

MXIPTAOA 17.5deg			#MAX INPUT AOA
MXIPTSSA 7deg			#MAX INPUT SSA
MXIPTROL 100deg			#MAX INPUT ROLL

PSTMPTCH 8deg			#Post-Stall Maneuver VPitch
PSTMYAW_ 3.5deg			#Post-Stall Maneuver VYaw
PSTMROLL 0deg			#Post-Stall Maneuver VRoll

MANESPD1 40kt			#MINIMUM MANEUVABLE SPEED
MANESPD2 70kt			#FULLY MANEUVABLE SPEED
CPITMANE 7.5			#PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0			#PITCH STABILITY CONSTANT
CYAWMANE 5.0			#YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0			#YAW STABILITY CONSTANT
CROLLMAN 3.2			#ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE
CTLBRAKE FALSE
CTLSPOIL 0.0
CTLABRNR FALSE
CTLTHROT 0.0
CTLIFLAP 0.0
CTLINVGW 0.0
CTLATVGW TRUE			#CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m
ATTITUDE 45deg 0deg 0deg
INITFUEL 75%
INITLOAD 0.0t
INITSPED 0.0MACH

HRDPOINT -1.98m -0.75m 0.27m B250
HRDPOINT 1.98m -0.75m 0.27m B250
HRDPOINT -2.4m -0.55m 0m RKT*1
HRDPOINT 2.4m -0.55m 0m RKT*1
HRDPOINT -2.53m -0.55m 0m RKT*1
HRDPOINT 2.53m -0.55m 0m RKT*1
HRDPOINT -2.66m -0.55m 0m RKT*1
HRDPOINT 2.66m -0.55m 0m RKT*1

WPNSHAPE B250 STATIC user/oranleed/la-5/arm/100kgbomb_s.srf
WPNSHAPE B250 FLYING user/oranleed/la-5/arm/100kgbomb_f.srf
WPNSHAPE RKT STATIC user/oranleed/la-5/arm/RS-82_s.srf
WPNSHAPE RKT FLYING user/oranleed/la-5/arm/RS-82_f.srf

SMOKEGEN -0.634m -0.023m 0.997m
FLAREPOS 0m -0.681m -0.487m 0m 0m 0m

LMTBYHDP TRUE

#ShVAK 20mm 700~800r/m
INITIGUN 400
GUNINTVL 0.08sec
GUNPOWER 2
GUNSIGHT FALSE
MACHNGUN 0.28m 0.503m 2.2m
MACHNGN2 -0.28m 0.503m 2.2m
GUNDIREC 0m 0.1m 1m		#GUN DIRECTION(5.71deg)

RADARCRS 1.0

GEARHORN FALSE			#LANDING-GEAR WARNING HORN
STALHORN FALSE			#STALL WARNING HORN

REFVCRUS 350kt			#CRUISING SPEED
REFACRUS 20000ft			#CRUISING ALTITUDE
REFTCRUS 1.00			#CRUISING THROTTLE SETTING

REFVLAND 84kt			#LANDING SPEED
REFAOALD 7deg			#LANDING AOA
REFLNRWY 500m			#RUNWAY REQUIRED TO STOP
REFTHRLD 0.35			#LANDING THROTTLE SETTING

AUTOCALC
