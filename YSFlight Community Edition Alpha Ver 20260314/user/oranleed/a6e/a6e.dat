REM A6E INTRUDER
IDENTIFY "A-6E_INTRUDER"
CATEGORY ATTACKER
AFTBURNR FALSE                #HAVE AFTERBURNER?
THRAFTBN  0.0t                #THRUST WITH AFTERBURNER
THRMILIT  8.4t                #THRUST AT MILITARY POWER
WEIGHCLN 12.1t                #WEIGHT CLEAN
WEIGFUEL  8.4t                #WEIGHT OF FUEL
WEIGLOAD  8.1t                #WEIGHT OF PAYLOAD
FUELABRN 0.0kg                #FUEL CONSUMPTION WHEN USING AFTERBURNER
FUELMILI 0.8kg               #FUEL CONSUMPTION AT MILITARY POWER

COCKPITP -0.35m  1.24m  2.68m  #COCKPIT POSITION
LEFTGEAR -2.05m -2.21m -1.56m  #LEFT LANDING GEAR POSITION
RIGHGEAR  2.05m -2.21m -1.56m  #RIGHT LANDING GEAR POSITION
WHELGEAR  0.0m -2.20m  4.13m  #WHEEL POSITION
ARRESTER  0.0m -2.0m -7.28m
MACHNGUN -0.0m -0.00m  0.00m  #MACHINE GUN POSITION
SMOKEGEN -0.0m  0.00m -6.00m  #SMOKE GENERATOR POSITION
VAPORPO0  8.1m -0.22m -4.10m  #VAPOR POSITION (Wings Swept Back or no-mVGW)
VAPORPO1  5.4m  0.05m -1.60m  #VAPOR POSITION (Wings Spread)
HTRADIUS  11m                #OUTSIDE SPHERE RADIUS

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

STRENGTH 8

CRITAOAP  20deg               #CRITICAL AOA POSITIVE
CRITAOAM -12deg               #CRITICAL AOA NEGATIVE

CRITSPED 0.8MACH              #CRITICAL SPEED
MAXSPEED 1050km/h             #MAXIMUM SPEED

HASSPOIL TRUE                 #HAS SPOILER?
RETRGEAR TRUE                 #HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE                #HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.2                  #EFFECT OF FLAP FOR Cl
CDBYFLAP 0.4                  #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5                  #EFFECT OF GEAR FOR Cd
CDSPOILR 2.0                  #EFFECT OF SPOILER FOR Cd

WINGAREA 49.1m^2                #WING AREA

MXIPTAOA 23.0deg              #MAX INPUT AOA
MXIPTSSA 5.0deg               #MAX INPUT SSA
MXIPTROL 160.0deg             #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 60kt                 #MINIMUM MANEUVABLE SPEED
MANESPD2 95kt                #FULLY MANEUVABLE SPEED
CPITMANE 7.0                  #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  #PITCH STABILITY CONSTANT
CYAWMANE 5.0                  #YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0                  #YAW STABILITY CONSTANT
CROLLMAN 3.0                  #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 #CONTROL LANDINGGEAR
CTLBRAKE FALSE                #CONTROL BRAKE
CTLSPOIL 0.0                  #CONTROL SPOILER
CTLABRNR FALSE                #CONTROL AFTERBURNER
CTLTHROT 0.0                  #CONTROL THRUST
CTLIFLAP 0.0                  #CONTROL FLAP
CTLINVGW 0.0                  #CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m           #POSITION
ATTITUDE 45deg 0deg 0deg      #ATTITUDE
INITFUEL 75%                  #INITIAL FUEL
INITLOAD 0.0t                 #INITIAL PAYLOAD
INITSPED 0.0MACH              #INITIAL SPEED

HRDPOINT 0m -1.4m -0.9m FUEL&1100

HRDPOINT 3.84m -0.51m -1.09m AGM65 B500HD RKT AIM9 FUEL&1100 B500HD
HRDPOINT -3.84m -0.51m -1.09m AGM65 B500HD RKT AIM9 FUEL&1100 B500HD
HRDPOINT 2.44m -0.63m -0.32m FUEL&1100 B500HD AGM65 RKT
HRDPOINT -2.44m -0.63m -0.32m  FUEL&1100 B500HD AGM65 RKT

HRDPOINT -2.64m -0.63m 0.8m B500
HRDPOINT 2.64m -0.63m 0.8m B500
HRDPOINT -2.24m -0.63m 0.8m B500
HRDPOINT 2.24m -0.63m 0.8m B500
HRDPOINT -2.44m -0.9m 0.8m B500
HRDPOINT 2.44m -0.9m 0.8m B500

HRDPOINT -2.68m -0.63m -1.5m B500
HRDPOINT 2.68m -0.63m -1.5m B500
HRDPOINT -2.20m -0.63m -1.5m B500
HRDPOINT 2.20m -0.63m -1.5m B500
HRDPOINT -2.44m -0.9m -1.5m B500
HRDPOINT 2.44m -0.9m -1.5m B500

HRDPOINT -4.04m -0.5m 0m B250
HRDPOINT 4.04m -0.5m 0m B250
HRDPOINT -3.64m -0.5m 0m B250
HRDPOINT 3.64m -0.5m 0m B250
HRDPOINT -3.84m -0.7m 0m B250
HRDPOINT 3.84m -0.7m 0m B250

HRDPOINT -4.04m -0.5m -2m B250
HRDPOINT 4.04m -0.5m -2m B250
HRDPOINT -3.64m -0.5m -2m B250
HRDPOINT 3.64m -0.5m -2m B250
HRDPOINT -3.84m -0.7m -2m B250
HRDPOINT 3.84m -0.7m -2m B250

LMTBYHDP TRUE                 #Limit Max Num Weapon by Hardpoint

WPNSHAPE AIM9 STATIC User/oranleed/a6e/weapon/aim9gs.srf
WPNSHAPE AIM9 FLYING User/oranleed/a6e/weapon/aim9g.srf
WPNSHAPE AGM65 STATIC User/oranleed/a6e/weapon/agm65s.srf
WPNSHAPE AGM65 FLYING User/oranleed/a6e/weapon/agm65.srf
WPNSHAPE B500 STATIC User/oranleed/a6e/weapon/mk82.srf
WPNSHAPE B500 FLYING User/oranleed/a6e/weapon/mk82.srf
WPNSHAPE B250 STATIC User/oranleed/a6e/weapon/mk81.srf
WPNSHAPE B250 FLYING User/oranleed/a6e/weapon/mk81.srf
WPNSHAPE B500HD STATIC User/oranleed/a6e/weapon/bgu12.srf
WPNSHAPE B500HD FLYING User/oranleed/a6e/weapon/bgu12.srf
WPNSHAPE RKT STATIC User/oranleed/a6e/weapon/rocketusas.srf
WPNSHAPE RKT FLYING User/oranleed/a6e/weapon/rocket.srf
WPNSHAPE FLR STATIC User/oranleed/a6e/flr.dnm
WPNSHAPE FLR FLYING User/oranleed/a6e/flr.dnm
WPNSHAPE FUEL STATIC User/oranleed/a6e/weapon/tank.srf
WPNSHAPE FUEL FLYING User/oranleed/a6e/weapon/tank.srf


MAXNMRKT 38
LMTBYHDP TRUE                 #Limit Max Num Weapon by Hardpoint
GUNPOWER 1
INITIGUN 0                  #INITIAL GUN
LOADWEPN B500 12
LOADWEPN AGM65 2
LOADWEPN FUEL 1100


REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 0.8MACH              #CRUISING SPEED
REFACRUS 20000ft              #CRUISING ALTITUDE
REFTCRUS 0.8                  #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 125kt                #LANDING SPEED
REFAOALD 9deg                #LANDING AOA
REFLNRWY 1000m                #RUNWAY REQUIRED TO STOP
REFTHRLD 0.4                  #LANDING THROTTLE SETTING

AUTOCALC
