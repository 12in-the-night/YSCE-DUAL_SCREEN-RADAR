#ïxémèdçHÅ@T5ó˚èKã@

IDENTIFY "T-5(51-6301)"
CATEGORY TRAINER
AFTBURNR FALSE				#HAVE AFTERBURNER?
PROPELLR 350HP				#PROPELLER ENGINE
WEIGHCLN  1.500t			#WEIGHT CLEAN
WEIGFUEL  0.630t			#WEIGHT OF FUEL
WEIGLOAD  0.4t				#WEIGHT OF PAYLOAD
FUELMILI 0.06893kg			#FUEL CONSUMPTION AT MILITARY POWER

COCKPITP  0.31m  0.48m  1.12m      	#COCKPIT POSITION
EXCAMERA "CO-PILOT" -0.31m  0.48m 1.12m 0deg 0deg 0deg INSIDE

LEFTGEAR -1.60m -1.40m  1.03m		#LEFT LANDING GEAR POSITION
RIGHGEAR  1.60m -1.40m  1.03m		#RIGHT LANDING GEAR POSITION
WHELGEAR  0.00m -1.43m  3.26m		#WHEEL POSITION
ARRESTER  0.00m -0.54m -5.43m		#ARRESTING HOCK POSITION
MACHNGUN  0.00m  0.00m  0.00m
SMOKEGEN  0.00m -0.02m -5.00m		#SMOKE GENERATOR POSITION
VAPORPO0  4.975m  -0.017m  1.051m		#VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1  4.975m  -0.017m  1.051m		#VAPOR POSITION (Wings Spread)
HTRADIUS  7.0m				#OUTSIDE SPHERE RADIUS
GUNSIGHT FALSE

TRIGGER1 GUN
TRIGGER2 AAM
TRIGGER3 AGM
TRIGGER4 SMK

STRENGTH 5

CRITAOAP 16deg				#CRITICAL AOA POSITIVE
CRITAOAM -10deg				#CRITICAL AOA NEGATIVE

CRITSPED 90km/h				#CRITICAL SPEED
MAXSPEED 357km/h			#MAXIMUM SPEED

HASSPOIL TRUE				#HAS SPOILER?
RETRGEAR TRUE				#HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE				#HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0				#EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0				#EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.1				#EFFECT OF FLAP FOR Cl
CDBYFLAP 0.2				#EFFECT OF FLAP FOR Cd
CDBYGEAR 0.5				#EFFECT OF GEAR FOR Cd
CDSPOILR 0.0				#EFFECT OF SPOILER FOR Cd

WINGAREA 13.6m^2			#WING AREA

MXIPTAOA 12.0deg			#MAX INPUT AOA
MXIPTSSA 5.0deg			#MAX INPUT SSA
MXIPTROL 65.0deg			#MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 30kt				#MINIMUM MANEUVABLE SPEED
MANESPD2 60kt				#FULLY MANEUVABLE SPEED
CPITMANE 7.0				#PITCH MANEUVERBILITY CONSTANT
CPITSTAB 5.2				#PITCH STABILITY CONSTANT
CYAWMANE 5.0				#YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0				#YAW STABILITY CONSTANT
CROLLMAN 3.2				#ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE				#CONTROL LANDINGGEAR
CTLBRAKE FALSE				#CONTROL BRAKE
CTLSPOIL 0.0				#CONTROL SPOILER
CTLABRNR FALSE				#CONTROL AFTERBURNER
CTLTHROT 0.0				#CONTROL THRUST
CTLIFLAP 0.0				#CONTROL FLAP
CTLINVGW 0.0				#CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE				#CONTROL AUTO VARIABLE GEOMETRY WING
VGWSPED1 0kt
VGWSPED2 0kt


POSITION 0m 3ft 0m			#POSITION
ATTITUDE 45deg 15deg 0deg		#ATTITUDE
INITFUEL 75%				#INITIAL FUEL
INITLOAD 0.0t				#INITIAL PAYLOAD
INITSPED 0.0MACH			#INITIAL SPEED

LMTBYHDP TRUE
MAXNMGUN 0
MAXNMFLR 5;
MAXNMAAM 0
MAXNAAMM 0
MAXNMAGM 0
MAXNMRKT 0
MAXNBOMB 0

GUNPOWER 0
INITIGUN 0
UNLOADWP
LOADWEPN FLR 5
FLAREPOS  -0.29m 1.14m -0.32m  0.0m 60.0m 5.0m	# FLARE DISPENSER POSITION AND VELOCITY

RADARCRS 1

GEARHORN FALSE				#LANDING-GEAR WARNING HORN
STALHORN FALSE				#STALL WARNING HORN

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 330km/h			#CRUISING SPEED(*1.2
REFACRUS 3700m			#CRUISING ALTITUDE
REFTCRUS 0.8				#CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 100km/h				#LANDING SPEED
REFAOALD 3deg				#LANDING AOA
REFLNRWY 250m				#RUNWAY REQUIRED TO STOP
REFTHRLD 0.6				#LANDING THROTTLE SETTING

AUTOCALC
