IDENTIFY "Boulton_Paul_Defiant_Mk.II"
CATEGORY WW2FIGHTER
SUBSTNAM "HURRICANE"
AFTBURNR FALSE                		#HAVE AFTERBURNER?
PROPELLR 1280HP               		#PROPELLER ENGINE
WEIGHCLN 2989kg                		#WEIGHT CLEAN
WEIGFUEL 373kg                		#WEIGHT OF FUEL
WEIGLOAD 459kg                		#WEIGHT OF PAYLOAD
FUELMILI 0.096kg               		#FUEL CONSUMPTION AT MILITARY POWER
PROPEFCY 0.74			#Propeller efficiency
PROPVMIN 120kt			#Minimum speed that T=P/V becomes valid

#empty: 2849kg max takeoff: 3821kg
#fuel consumption rate : 0.075kg/1000HP*sec
#range748km/(speed416km/h(225kt))*60*60*(0.096kg*0.60)=373kg

COCKPITP 0m 0.660m -0.400m		#COCKPIT POSITION
COCKPITA 0deg 0deg 0deg    		#COCKPIT NEUTRAL VIEW DIRECTION
SCRNCNTR 0.00 0.00		#Position of viewpoint
EXCAMERA "GUNNER_FRONT" 0m 0.75m -1.6861m 0deg 47deg 0deg INSIDE
EXCAMERA "GUNNER_RIGHT" 0m 0.75m -1.6861m -90deg 37.5deg 0deg INSIDE
EXCAMERA "GUNNER_BACK" 0m 0.75m -1.6861m -180deg 28deg 0deg INSIDE
EXCAMERA "GUNNER_LEFT" 0m 0.75m -1.6861m 90deg 37.5deg 0deg INSIDE
LEFTGEAR -1.72m -2.1427m 0.5687m	#LEFT LANDING GEAR POSITION
RIGHGEAR 1.72m -2.1427m 0.5687m	#RIGHT LANDING GEAR POSITION
WHELGEAR 0m -0.9815m -5.4911m	#WHEEL POSITION
ARRESTER 0m -0.9815m -5.4911m	#ARRESTING FOOK
SMOKEGEN 0m -0.1m 1.8m		#SMOKE GENERATOR POSITION
VAPORPO0 5.981m -0.4141m -0.0686m	#VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1 5.981m -0.4141m -0.0686m	#VAPOR POSITION (Wings Spread)
HTRADIUS 7.0m			#OUTSIDE SPHERE RADIUS

STRENGTH 7

INSTPANL User/oranleed/defiant/defiant.ist
ISPNLPOS 0m 0m 0.2948m		#INSIDE PANEL POTITION
ISPNLATT 0deg 0deg 0deg		#INSIDE PANEL ATTITUDE
ISPNLSCL 1.0			#INSIDE PANEL SCALE

CRITAOAP  15deg               		#CRITICAL AOA POSITIVE
CRITAOAM -10deg               		#CRITICAL AOA NEGATIVE

CRITSPED 300kt              		#CRITICAL SPEED
MAXSPEED 400kt              		#MAXIMUM SPEED

HASSPOIL TRUE			#HAS SPOILER?
RETRGEAR TRUE			#HAS RETRACTABLE LANDING GEAR?
VARGEOMW FALSE			#HAS VARIABLE GEOMETRY WING?
TRSTVCTR TRUE			#HAS THRUST VECTORING CAPABILITY?

TRSTDIR0 0.0m 0.0m 1.0m       		#Thrust vector 0
TRSTDIR1 0.0m 0.0m 1.0m       		#Thrust vector 1
PSTMPTCH 2.0deg                 		#Post-Stall Maneuver VPitch
PSTMYAW_ 1.0deg                 		#Post-Stall Maneuver VYaw
PSTMROLL 0deg                 		#Post-Stall Maneuver VRoll

CLVARGEO 0.0                  		#EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                  		#EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.2                  		#EFFECT OF FLAP FOR Cl
CDBYFLAP 0.6                  		#EFFECT OF FLAP FOR Cd
CDBYGEAR 0.8                  		#EFFECT OF GEAR FOR Cd
CDSPOILR 0.05                  		#EFFECT OF SPOILER FOR Cd

WINGAREA 23.23m^2			#WING AREA

MXIPTAOA 16.0deg              		#MAX INPUT AOA
MXIPTSSA 6.2deg               		#MAX INPUT SSA
MXIPTROL 67.0deg             		#MAX INPUT ROLL

MANESPD1 45kt                 		#MINIMUM MANEUVABLE SPEED
MANESPD2 100kt                 		#FULLY MANEUVABLE SPEED
CPITMANE 6.2                  		#PITCH MANEUVERBILITY CONSTANT
CPITSTAB 3.0                  		#PITCH STABILITY CONSTANT
CYAWMANE 4.6                  		#YAW MANEUVABILITY CONSTANT
CYAWSTAB 3.0                  		#YAW STABILITY CONSTANT
CROLLMAN 2.9                  		#ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                 		#CONTROL LANDINGGEAR
CTLBRAKE FALSE                		#CONTROL BRAKE
CTLSPOIL 0.0                  		#CONTROL SPOILER
CTLABRNR FALSE                		#CONTROL AFTERBURNER
CTLTHROT 0.0                  		#CONTROL THRUST
CTLIFLAP 0.0                  		#CONTROL FLAP
CTLINVGW 0.0                  		#CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                		#CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m           		#POSITION
ATTITUDE 45deg 0deg 0deg      	#ATTITUDE
INITFUEL 75%                 		#INITIAL FUEL
INITLOAD 0.0t                 		#INITIAL PAYLOAD
INITSPED 0.0MACH              		#INITIAL SPEED

INITIGUN 0                  		#INITIAL GUN
GUNSIGHT FALSE			#GUNSIGHT

RADARCRS 1.0			#RARAR CROSS SECTION

GEARHORN FALSE                		#LANDING-GEAR WARNING HORN
STALHORN FALSE                 	#STALL WARNING HORN

#1kt=1.852km/h
#1ft=0.3048m

REFVCRUS 272kt              		#CRUISING SPEED
REFACRUS 19000ft              		#CRUISING ALTITUDE
REFTCRUS 1.0                  		#CRUISING THROTTLE SETTING

REFVLAND 75kt                 		#LANDING SPEED
REFAOALD 8.0deg                		#LANDING AOA
REFLNRWY 600m                		#RUNWAY REQUIRED TO STOP
REFTHRLD 0.56                 		#LANDING THROTTLE SETTING

NMTURRET 9

#gun 7.7mm 400~600r/m x4 total 2400rounds
#total 500*4*0.5=1000r/m 2400*0.5=1200r
TURRETPO 0 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 0 9.5deg 80.5deg 9.5deg
TURRETHD 0 -180deg 180deg 0deg
TURRETAM 0 600
TURRETIV 0 0.12sec
TURRETRG 0 2000m
TURRETCT 0 PILOT
TURRETNH 0 8001
TURRETNP 0 8006
TURRETPO 1 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 1 9.5deg 80.5deg 9.5deg
TURRETHD 1 -180deg 180deg 0deg
TURRETAM 1 600
TURRETIV 1 0.12sec
TURRETRG 1 500m
TURRETCT 1 PILOT
TURRETNH 1 8002
TURRETPO 2 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 2 9.5deg 80.5deg 9.5deg
TURRETHD 2 -180deg 180deg 0deg
TURRETAM 2 0
TURRETCT 2 PILOT
TURRETNH 2 8003
TURRETPO 3 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 3 9.5deg 80.5deg 9.5deg
TURRETHD 3 -180deg 180deg 0deg
TURRETAM 3 0
TURRETCT 3 PILOT
TURRETNH 3 8004
TURRETPO 4 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 4 9.5deg 80.5deg 9.5deg
TURRETHD 4 -180deg 180deg 0deg
TURRETAM 4 0
TURRETCT 4 PILOT
TURRETNH 4 8005

#radar range=6km
TURRETPO 5 0m 0m 0m 0deg 0deg 0deg
TURRETPT 5 -35deg 35deg 0deg
TURRETHD 5 -35deg 35deg 0deg
TURRETAM 5 0
TURRETCT 5 GUNNER
TURRETNM 5 9001
TURRETAR 5
TURRETRG 5 15000m
TURRETPO 6 0m 0m 0m 0deg 0deg 0deg
TURRETPT 6 -35deg 35deg 0deg
TURRETHD 6 -35deg 35deg 0deg
TURRETAM 6 0
TURRETCT 6 GUNNER
TURRETNM 6 9002
TURRETAR 6
TURRETRG 6 15000m
TURRETPO 7 0m 0m 0m 0deg 0deg 0deg
TURRETPT 7 -35deg 35deg 0deg
TURRETHD 7 -35deg 35deg 0deg
TURRETAM 7 0
TURRETCT 7 GUNNER
TURRETNM 7 9003
TURRETAR 7
TURRETRG 7 15000m

#site
TURRETPO 8 0m 0.5526m -1.6861m -90deg 0deg -9.5deg
TURRETPT 8 9.5deg 80.5deg 9.5deg
TURRETHD 8 -180deg 180deg 0deg
TURRETAM 8 0
TURRETCT 8 PILOT
TURRETNM 8 7001

AUTOCALC
