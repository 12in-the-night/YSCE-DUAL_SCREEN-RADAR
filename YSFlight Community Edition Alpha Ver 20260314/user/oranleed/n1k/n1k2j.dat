RADARCRS 0.5

GEARHORN FALSE				#LANDING-GEAR WARNING HORN
STALHORN FALSE				#STALL WARNING HORN

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 540km/h              #CRUISING SPEED
REFACRUS 7000ft              #CRUISING ALTITUDE
REFTCRUS 0.7                  #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 70kt                 #LANDING SPEED
REFAOALD 7.5deg                #LANDING AOA
REFLNRWY 600m                 #RUNWAY REQUIRED TO STOP
REFTHRLD 0.4                  #LANDING THROTTLE SETTING

WPNSHAPE FUEL STATIC User/fasta/sakadati/n1k/exttank.srf
WPNSHAPE FUEL FLYING User/fasta/sakadati/n1k/exttank.srf
AUTOCALC
